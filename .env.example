# 应用
APP_NAME=Digital Employee Platform
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
LOG_LEVEL=INFO
# python -m app.main 启动时的监听地址与热重载
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false
# 前后端分离后的前端地址；根路径 / 会重定向到这里
FRONTEND_URL=http://localhost:5173

# 安全
SECRET_KEY=change-me-in-production-use-at-least-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 数据库（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://de:de@192.168.100.168:5432/digital_employee_platform
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/digital_employee_platform
# DATABASE_URL=mysql+aiomysql://user:password@host:3306/digital_employee

# 开发期自动建表（生产请设为 false，并执行 alembic upgrade head）
AUTO_CREATE_TABLES=true
# 生产配置检查：发现问题时仅告警；设为 true 则启动失败
STRICT_CONFIG_CHECK=false
# 数据库连接池
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# CORS，多个用逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 大模型（DeepSeek 示例；Key 也可直接放在 LLM_API_KEY）
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
# OpenAI 兼容示例：
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1

# 也可直接设置系统环境变量 DEEPSEEK_API_KEY，服务会自动读取。
# DeepSeek 不提供 embeddings；Embedding 需单独配置 EMBEDDING_API_KEY。

# MCP stdio 允许执行的命令白名单（留空表示不限制，生产环境务必配置）
MCP_ALLOWED_COMMANDS=python,python3,node,npx,uvx,uv

# 任务队列 / Worker
# QUEUE_BACKEND=db  ：数据库持久化队列（默认，无需 Redis）
# QUEUE_BACKEND=celery：Celery + Redis；需 pip install ".[workers]" 并启动 scripts/celery_worker.py
QUEUE_BACKEND=db
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_TASK_QUEUE=tasks
# 开发期内联 Worker；独立部署时设为 false 并运行 python -m scripts.worker
# Celery 模式下 API 不会启动内联任务 Worker，避免重复执行
INLINE_WORKER=true
WORKER_POLL_INTERVAL=0.5
WORKER_CONCURRENCY=2
WORKER_STALE_SECONDS=600

# 任务触发器（主动汇报/周期任务）
TRIGGER_WORKER_ENABLED=true
TRIGGER_POLL_INTERVAL=30

# 重试策略
TASK_MAX_ATTEMPTS=3
TASK_RETRY_BASE_SECONDS=10
TASK_RETRY_MAX_SECONDS=300

# 监控 / 告警
WORKER_HEARTBEAT_INTERVAL=10
WORKER_HEARTBEAT_TIMEOUT=30
ALERT_CHECK_INTERVAL=60
# 每 1000 token 的成本估算，0 表示不计算
LLM_COST_PER_1K_TOKENS=0.0

# AIGC 内容生成
AIGC_STORAGE_DIR=./data/aigc
AIGC_PUBLIC_PREFIX=/media
AIGC_WORKER_ENABLED=true
AIGC_WORKER_POLL_INTERVAL=1.0
AIGC_WORKER_CONCURRENCY=2
AIGC_JOB_MAX_ATTEMPTS=2
# 应大于单次视频生成的最长耗时，避免运行中的任务被误回收
AIGC_STALE_SECONDS=1800
AIGC_REQUEST_TIMEOUT_SECONDS=180
AIGC_UPLOAD_MAX_BYTES=20971520
AIGC_DOWNLOAD_MAX_BYTES=209715200

# 审批流
APPROVAL_WORKER_ENABLED=true
APPROVAL_TIMEOUT_CHECK_INTERVAL=60

# 知识检索 / Embedding
# 外部 Embedding（留空则使用本地哈希向量）
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_DIM=256
LOCAL_EMBEDDING_ENABLED=true
# auto=检测到 pgvector 就用；json=强制 JSON 内积；pgvector=优先 pgvector
# 需要 PostgreSQL 安装 pgvector 扩展（当前 VM 的 de-pg 默认没有，会自动回退）
VECTOR_BACKEND=auto

# 多模态解析（图片/音频/PDF 需要外部 OCR/ASR/PDF Provider）
MULTIMODAL_PROVIDER_URL=
MULTIMODAL_PROVIDER_API_KEY=
MULTIMODAL_TIMEOUT=120
MULTIMODAL_MAX_BYTES=20971520

# 外部训练服务（DPO/SFT）；留空时只维护训练台账
TRAINING_PROVIDER_URL=
TRAINING_PROVIDER_API_KEY=
TRAINING_PROVIDER_TIMEOUT=60
TRAINING_DATASET_MAX_BYTES=52428800

# 可观测性
METRICS_ENABLED=true
# 登录/注册进程内限流（多实例时每进程独立，建议网关再限流）
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_PER_MINUTE=10

